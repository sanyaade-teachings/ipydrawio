{
  "private": true,
  "name": "@deathbeds/ipydrawio-meta",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc --build src",
    "watch": "jlpm build --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@deathbeds/ipydrawio": "file:../ipydrawio",
    "@deathbeds/ipydrawio-jupyter-templates": "file:../ipydrawio-jupyter-templates",
    "@deathbeds/ipydrawio-notebook": "file:../ipydrawio-notebook",
    "@deathbeds/ipydrawio-pdf": "file:../ipydrawio-pdf",
    "@deathbeds/ipydrawio-webpack": "file:../ipydrawio-webpack"
  },
  "scripts_doit": {
    "build": {
      "file_dep": [
        "../*/src/**/*.ts",
        "../*/src/tsconfig.json",
        "../*/style/**/*.*",
        "../*/tsconfig.json",
        "../tsconfigbase.json"
      ],
      "targets": [
        ".root.tsbuildinfo",
        ".src.tsbuildinfo"
      ]
    }
  }
}
